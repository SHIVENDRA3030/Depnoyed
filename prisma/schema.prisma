generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  mongoId      String       @id @default(auto()) @map("_id") @db.ObjectId
  id           String       @unique
  email        String       @unique
  name         String?
  passwordHash String
  isAdmin      Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deployments  Deployment[]

  @@map("users")
}

model App {
  mongoId       String       @id @default(auto()) @map("_id") @db.ObjectId
  id            String       @unique
  name          String
  slug          String       @unique
  description   String
  dockerImage   String
  containerPort Int
  logo          String?
  category      String
  simulator     String
  defaultEnv    String?
  readme        String?
  repository    String?
  website       String?
  version       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deployments   Deployment[]

  @@map("apps")
}

model Deployment {
  mongoId       String   @id @default(auto()) @map("_id") @db.ObjectId
  id            String   @unique
  userId        String
  appId         String
  containerId   String?
  containerName String
  volumeName    String
  status        String
  subdomain     String   @unique
  port          Int?
  label         String?
  envVars       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  app  App  @relation(fields: [appId], references: [id])

  @@map("deployments")
}
