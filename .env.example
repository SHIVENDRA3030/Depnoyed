# ---------------------------------------------------------------------------
# Depnoyed / OSS Deploy — environment variable template
#
# Copy this file to `.env` and fill in real values. NEVER commit your real
# `.env` file — only this `.env.example` belongs in version control.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string for the raw `mongodb` driver
# (backend/mongo.ts). This is the PRIMARY database — all User, App, and
# Deployment records live here. Format:
#   mongodb+srv://<user>:<password>@<cluster>/?appName=<app>
# Retrieve from the MongoDB Atlas dashboard -> Connect -> Drivers.
# NEVER commit a real connection string — only this placeholder belongs in VC.
MONGODB_URI="[REDACTED:mongodb_atlas_connection_string]"

# Default database name used by backend/mongo.ts when the URI does not include
# one in the path. Collections for users / apps / deployments will live here.
MONGODB_DB_NAME="depnoyed"

# HMAC signing secret for session cookies (ossmp_session). Used by
# backend/auth.ts to sign and verify { uid, email, iat } tokens. MUST be set
# to a high-entropy random value in any non-dev environment.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET="replace-me-with-openssl-rand-hex-32"

# CPU limit applied to every deployment container (float, in whole CPUs).
# Mapped to NanoCpus by the real Docker adapter.
DEPLOY_CPU_LIMIT="1"

# CFS CPU period in microseconds (Linux kernel CFS scheduler parameter).
# Default 100000 is the standard Docker value. (Unused by dockerode — kept
# for backwards compatibility with the mock adapter documentation.)
DEPLOY_CPU_PERIOD="100000"

# Memory limit per deployment container, in megabytes.
# Mapped to Memory by the real Docker adapter. 1024MB is enough for Grafana,
# Postgres, Redis, Gitea. Mattermost may need 2048.
DEPLOY_MEMORY_LIMIT_MB="1024"

# Base domain appended to generated deployment subdomains to construct the
# public URL: <slug>-<rand6>.<DEPLOY_BASE_DOMAIN>
DEPLOY_BASE_DOMAIN="apps.local"

# Runtime adapter used by the Deployment Manager.
#   mock   — high-fidelity in-process simulation (default; sandbox runtime)
#   docker — real Docker engine via dockerode (requires Docker installed)
DOCKER_ADAPTER="mock"

# When DOCKER_ADAPTER=mock, controls whether simulated volumes are persisted
# to disk under .ossmp-data/volumes/. Set to "false" to keep volumes purely
# in-memory (useful for tests).
MOCK_PERSIST="true"

# Path to the Docker daemon socket (only used when DOCKER_ADAPTER=docker).
# Default is the standard unix socket. On macOS/Windows Docker Desktop this
# is also the default. Override only if you run Docker on a non-standard path
# or connect over TCP (e.g. "tcp://192.168.1.10:2375").
DOCKER_SOCKET="/var/run/docker.sock"

# Base URL of the Docker host, used to construct "Open real app" links when
# DOCKER_ADAPTER=docker. Containers are bound to host ports in the configured
# range, so a deployment's real URL becomes <DEPLOY_REAL_APP_BASE_URL>:<port>.
# Use "http://localhost" when running Docker Desktop locally. Leave empty to
# hide the "Open real app" link entirely.
DEPLOY_REAL_APP_BASE_URL="http://localhost"

# Host port range for binding container ports. Each new deployment picks the
# first free port in [start, end). Keep this range well above 1024 and below
# 65535. Default 31000-39999 matches the ephemeral range used by the mock.
DOCKER_PORT_RANGE_START="31000"
DOCKER_PORT_RANGE_END="39999"

# Whether to start containers with a read-only root filesystem (--read-only).
# Defaults to false because most real marketplace images (Postgres, Redis,
# Grafana, Gitea, Mattermost) need to write to /var/lib, /var/run, /tmp, etc.
# Set to "true" only if you know your images tolerate it.
DOCKER_READONLY_ROOTFS="false"

# OPTIONAL. GitHub personal access token, used only by repo-automation
# scripts that push this repository to GitHub via the API. Never required to
# run the app, and never commit a real token to the repo.
# GITHUB_TOKEN="[REDACTED:github_token]"
