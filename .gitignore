# ============================================================================
# OSS Deploy / Depnoyed — .gitignore
# ============================================================================

# --- Dependencies ---
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js ---
/.next/
/out/
next-env.d.ts

# --- Production build ---
/build

# --- TypeScript ---
*.tsbuildinfo

# --- Environment & secrets (NEVER commit) ---
.env
.env.*
!.env.example
*.pem

# --- Database (SQLite local data) ---
db/*.db
db/*.db-journal
backend/prisma/*.db
backend/prisma/migrations/dev.db*

# --- Mock runtime state (sandbox only) ---
.ossmp-data/

# --- Logs ---
*.log
dev.log
dev.out.log
server.log

# --- Debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Vercel ---
.vercel

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Local sandbox / agent artifacts (NOT part of the project) ---
.zscripts/
.claude
.z-ai-config
/skills/
prompt
test
upload/
download/
tool-results/
agent-ctx/
worklog.md

# --- Misc ---
local-*
